# Copy to .env and fill in. .env is in .gitignore and must never be committed.

# "fake" works offline with canned answers; "openai_compat" uses a real LLM.
ASSIST_PROVIDER=openai_compat

# --- Google Gemini (free tier) ---
ASSIST_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ASSIST_API_KEY=paste-your-key-here
ASSIST_MODEL=gemini-3.8-flash
ASSIST_FAST_MODEL=gemini-3.5-flash-lite
ASSIST_REASONING_EFFORT=low

# --- Groq (free tier), as an alternative ---
# ASSIST_BASE_URL=https://api.groq.com/openai/v1
# ASSIST_API_KEY=paste-your-key-here
# ASSIST_MODEL=openai/gpt-oss-20b
# ASSIST_FAST_MODEL=openai/gpt-oss-20b
# ASSIST_REASONING_EFFORT=low

# Optional
# ASSIST_PORT=50061
# ASSIST_MAX_INPUT_CHARS=8000
# ASSIST_DEFAULT_TIMEOUT_S=20